# ─── Database ─────────────────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_NAME=phishing_detection_db
DB_USER=root
DB_PASSWORD=your_mysql_password_here

# ─── JWT Authentication ───────────────────────────────────────────────────────
# Generate a strong secret: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your-super-secret-jwt-key-change-this-in-production-min-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ─── Application ──────────────────────────────────────────────────────────────
APP_NAME=Phishing Detection System
APP_VERSION=1.0.0
DEBUG=True
BACKEND_PORT=8000

# ─── CORS ─────────────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:5173

# ─── ML Models ────────────────────────────────────────────────────────────────
ML_MODELS_DIR=../ml/saved_models
ACTIVE_MODEL=xgboost

# ─── Analysis Settings ────────────────────────────────────────────────────────
# Deep scan fetches the webpage for additional content-based features (slower)
DEEP_SCAN_ENABLED=False
DEEP_SCAN_TIMEOUT=10
MAX_URL_LENGTH=2048
