{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "FastAPI Backend",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": [
        "app.main:app",
        "--reload",
        "--port",
        "8000"
      ],
      "cwd": "${workspaceFolder}/backend",
      "jinja": true
    },
    {
      "name": "Train ML Models",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/ml/train_models.py",
      "console": "integratedTerminal"
    }
  ]
}
